{
  "name": "ai-comic",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "build:web": "npm run build --workspace=web",
    "dev:server": "npm run dev --workspace=server",
    "lint": "npm run lint --workspace=web",
    "build": "npm run build --workspace=web",
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:web\"",
    "start": "concurrently -k \"npm run dev:server\" \"npm run dev:web\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
